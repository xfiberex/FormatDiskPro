<?xml version="1.0" encoding="utf-8"?>
<!--
  Un solo origen de paquetes: nuget.org (AUD-022).

  Sin este archivo, cada máquina restaura de los orígenes que tenga configurados (en la del mantenedor, además
  de nuget.org, la carpeta «Microsoft Visual Studio Offline Packages»), y dos compilaciones del mismo commit
  podían sacar el mismo número de versión de sitios distintos. <clear/> descarta los de la máquina.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
