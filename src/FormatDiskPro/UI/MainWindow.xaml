<Window
    x:Class="FormatDiskPro.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FormatDiskPro.UI"
    Title="FormatDiskPro">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Custom title bar drag area (caption buttons themed automatically by WinUI) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="14,0,0,0" Spacing="12">
                <Image x:Name="TitleBarIcon" Width="16" Height="16" />
                <TextBlock Text="FormatDiskPro" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Row 1: MenuBar

             Atajos (T7-04): SOLO los tres diagnósticos que no escriben nada —salud, benchmark e
             historial—, más el F5 de la lista de unidades. Formatear, reinicializar, verificar
             capacidad y borrado seguro NO llevan atajo a propósito: una combinación de teclas mal
             pulsada no puede ser el primer paso de una operación que borra datos, y su confirmación
             reforzada (escribir la letra) existe precisamente para que llegar ahí cueste.

             El texto del atajo lo pinta el propio MenuFlyoutItem al haber un KeyboardAccelerator: no
             hace falta KeyboardAcceleratorTextOverride, que es para cuando NO hay acelerador real y se
             quiere anunciar uno igualmente. -->
        <StackPanel Grid.Row="1">
        <MenuBar>
            <MenuBarItem x:Name="MnuTools" Title="Herramientas">
                <MenuFlyoutItem x:Name="MnuVerify" Text="Verificar capacidad real…" Click="MnuVerify_Click" />
                <MenuFlyoutItem x:Name="MnuHealth" Text="Salud del disco (S.M.A.R.T.)…" Click="MnuHealth_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="I" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MnuCheck"  Text="Comprobar errores (chkdsk)…" Click="MnuCheck_Click" />
                <MenuFlyoutItem x:Name="MnuBenchmark" Text="Benchmark rápido (lectura/escritura)…" Click="MnuBenchmark_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="B" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MnuUnlock" Text="Quitar protección de escritura…" Click="MnuUnlock_Click" />
                <MenuFlyoutItem x:Name="MnuReinit" Text="Reinicializar unidad…"     Click="MnuReinit_Click" />
                <MenuFlyoutItem x:Name="MnuEject"  Text="Expulsar unidad"           Click="MnuEject_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MnuHistory" Text="Ver historial"            Click="MnuHistory_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="H" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem x:Name="MnuConfig" Title="Configuración">
                <MenuFlyoutSubItem x:Name="MnuLang" Text="Idioma">
                    <ToggleMenuFlyoutItem x:Name="MnuLangEs" Text="Español"  IsChecked="True" Click="MnuLangEs_Click" />
                    <ToggleMenuFlyoutItem x:Name="MnuLangEn" Text="English"               Click="MnuLangEn_Click" />
                    <ToggleMenuFlyoutItem x:Name="MnuLangPt" Text="Português"             Click="MnuLangPt_Click" />
                    <ToggleMenuFlyoutItem x:Name="MnuLangFr" Text="Français"              Click="MnuLangFr_Click" />
                    <ToggleMenuFlyoutItem x:Name="MnuLangIt" Text="Italiano"              Click="MnuLangIt_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="MnuTheme" Text="Tema">
                    <ToggleMenuFlyoutItem x:Name="MnuThemeAuto"  Text="Automático" IsChecked="True" Click="MnuThemeAuto_Click" />
                    <ToggleMenuFlyoutItem x:Name="MnuThemeLight" Text="Claro"                       Click="MnuThemeLight_Click" />
                    <ToggleMenuFlyoutItem x:Name="MnuThemeDark"  Text="Oscuro"                      Click="MnuThemeDark_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="MnuPresets" Text="Presets" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="MnuNotify" Text="Avisar al terminar" Click="MnuNotify_Click" />
                <ToggleMenuFlyoutItem x:Name="MnuCheckUpdatesOnStartup" Text="Buscar actualizaciones al iniciar" Click="MnuCheckUpdatesOnStartup_Click" />
            </MenuBarItem>
            <MenuBarItem x:Name="MnuHelp" Title="Ayuda">
                <MenuFlyoutItem x:Name="MnuUpdates" Text="Buscar actualizaciones…" Click="MnuUpdates_Click" />
                <MenuFlyoutItem x:Name="MnuWhatsNew" Text="Novedades…" Click="MnuWhatsNew_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MnuLicense" Text="Licencia…" Click="MnuLicense_Click" />
                <MenuFlyoutItem x:Name="MnuThirdParty" Text="Avisos de terceros…" Click="MnuThirdParty_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MnuAbout" Text="Acerca de…" Click="MnuAbout_Click" />
            </MenuBarItem>
        </MenuBar>

            <!-- ── Barra de acciones rápidas (T11-02) ─────────────────────────────────────────

                 Hasta aquí, TODA función que no fuera formatear vivía dentro de `MnuTools`: la salud
                 del disco, el benchmark y el historial no existían para quien no abriera el menú.

                 Suben EXACTAMENTE estas tres, y el criterio no es nuevo: son las mismas que ya tenían
                 atajo de teclado (Ctrl+I / Ctrl+B / Ctrl+H), y por el mismo motivo que allí —son las
                 únicas que NO escriben nada—. Formatear, reinicializar, verificar capacidad, quitar
                 protección y borrado seguro se quedan en el menú: una operación que borra datos no debe
                 estar a un clic de distancia, y su confirmación reforzada existe precisamente para que
                 llegar ahí cueste.

                 Ese criterio resuelve además el problema de T7-08 sin repetir su solución: WinUI no
                 pinta el tooltip de un control deshabilitado, así que un botón de icono apagado sería
                 mudo. Estos tres solo se apagan cuando NO hay unidad —y entonces el propio selector, a
                 dos centímetros, ya dice «No hay unidades — conecta un dispositivo»—. El historial no
                 se apaga nunca.

                 NO llevan KeyboardAccelerator propio: el acelerador ya está en su ítem del menú y
                 declararlo dos veces lo duplicaría. El atajo se anuncia en el tooltip. -->
            <Grid x:Name="QuickBar" ColumnDefinitions="*,*,*" ColumnSpacing="8"
                  Margin="16,2,16,0">
                <Button x:Name="BtnHealth" HorizontalAlignment="Stretch" Click="MnuHealth_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE95E;" FontSize="15"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="BtnHealthLbl" Text="Salud" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnBenchmark" Grid.Column="1" HorizontalAlignment="Stretch"
                        Click="MnuBenchmark_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE916;" FontSize="15"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="BtnBenchmarkLbl" Text="Benchmark" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnHistory" Grid.Column="2" HorizontalAlignment="Stretch"
                        Click="MnuHistory_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE81C;" FontSize="15"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="BtnHistoryLbl" Text="Historial" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Row 2: Scrollable content — cards inspired by Win11Debloat sections -->
        <Grid Grid.Row="2" RowDefinitions="*,Auto">
        <ScrollViewer x:Name="ContentScroller" Padding="0"
                      VerticalScrollBarVisibility="Auto"
                      ViewChanged="ContentScroller_ViewChanged"
                      SizeChanged="ContentScroller_SizeChanged">
            <!-- El SizeChanged va aquí y NO (solo) en el ScrollViewer: el del ScrollViewer mide el
                 HUECO, que no cambia nunca en una ventana de tamaño fijo. Lo que crece es el CONTENIDO
                 —la tarjeta de unidad al rellenarse, las opciones al aparecer—, y es eso lo que decide
                 si hay algo que desplazar. Con el manejador solo en el ScrollViewer, la barra no salía. -->
            <StackPanel x:Name="ContentPanel" Padding="16,14,16,16" Spacing="12"
                        SizeChanged="ContentScroller_SizeChanged">

                <!-- Aviso persistente: unidad de sistema protegida (formateo deshabilitado) -->
                <InfoBar x:Name="ProtectedBar" Severity="Warning" IsClosable="False" IsOpen="False" />

                <!-- ── Card: Unidad (selección + información) ── -->
                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDA2;" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock x:Name="UnitGroupLbl" Text="Unidad" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>

                        <Grid ColumnSpacing="8" ColumnDefinitions="*,Auto">
                            <ComboBox x:Name="DrivePicker" HorizontalAlignment="Stretch"
                                      SelectionChanged="DrivePicker_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="ui:DriveViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Center"
                                                      Foreground="{x:Bind ForegroundBrush, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind DisplayText}" VerticalAlignment="Center"
                                                       Foreground="{x:Bind ForegroundBrush, Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="RefreshButton" Grid.Column="1" VerticalAlignment="Stretch"
                                    Width="40" Padding="0" Click="RefreshButton_Click">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F5" />
                                </Button.KeyboardAccelerators>
                                <!-- El botón ya tiene nombre accesible (AutomationProperties.SetName con
                                     tip.refresh): su glifo no aporta nada al lector de pantalla. -->
                                <FontIcon Glyph="&#xE72C;" FontSize="16"
                                          AutomationProperties.AccessibilityView="Raw" />
                                <ToolTipService.ToolTip>
                                    <ToolTip x:Name="RefreshTooltip" Content="Actualizar lista" />
                                </ToolTipService.ToolTip>
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource CardDividerStyle}" />

                        <!-- ── Cabecera de la unidad (T11-03) ───────────────────────

                             Antes esto era una rejilla de 2×3 con seis líneas «Etiqueta: valor» del
                             mismo tamaño y del mismo color. Eso le daba a «Conexión: USB» exactamente
                             el mismo peso que a «Salud: Crítico», y las dos preguntas que se hacen al
                             seleccionar una unidad —cuánto cabe y si está sana— había que buscarlas
                             entre las otras cuatro.

                             Ahora hay tres niveles: la CAPACIDAD como dato principal, la SALUD a su
                             derecha con su punto de color, y el resto —sistema de archivos, tipo y
                             conexión— en una línea de contexto atenuada. Es el mismo contenido y los
                             mismos seis controles, reordenados por importancia.

                             Los rótulos («Total:», «Salud:»…) desaparecen de la pantalla porque el
                             valor solo ya se entiende —«930,5 GB» no necesita que le digan que es el
                             total—, pero NO desaparecen de la accesibilidad: el código les pone la
                             frase entera en AutomationProperties.Name, así que un lector de pantalla
                             sigue leyendo «Total: 930,5 GB». La jerarquía visual no se paga con
                             información. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock x:Name="InfoTotalText" Style="{StaticResource DriveCapacityStyle}"
                                       Text="–" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                                        VerticalAlignment="Center">
                                <!-- El punto repite en color lo que el texto dice en palabras; el color
                                     nunca es el único portador (WCAG 1.4.1). Va en Raw: un lector de
                                     pantalla ya recibe «Salud: Normal» del TextBlock de al lado. -->
                                <Ellipse x:Name="InfoHealthDot" Width="8" Height="8"
                                         VerticalAlignment="Center"
                                         AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="InfoHealthText" Style="{StaticResource InfoTextStyle}"
                                           Text="–" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,-4,0,0">
                            <TextBlock x:Name="InfoFsText" Style="{StaticResource DriveMetaStyle}" Text="–" />
                            <TextBlock Style="{StaticResource DriveMetaStyle}" Text="·"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="InfoTypeText" Style="{StaticResource DriveMetaStyle}" Text="–" />
                            <TextBlock Style="{StaticResource DriveMetaStyle}" Text="·"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="InfoBusText" Style="{StaticResource DriveMetaStyle}" Text="–" />
                        </StackPanel>

                        <!-- Ocupación usado/libre de un vistazo (oculta si la unidad no está lista).

                             Ya no es un ProgressBar: su plantilla pinta la pista con una altura FIJA de
                             1 px (ProgressBarTrackHeight) mientras el relleno ocupa el MinHeight, así que
                             «usado» y «libre» no pueden tener el mismo grosor por muchos recursos que se
                             sobrescriban. Aquí la pista es el propio Border (espacio libre) y el relleno es
                             su hijo (espacio usado): dos colores medidos, un solo grosor, y sitio para más
                             segmentos el día que la barra tenga que mostrar varias particiones.

                             Los colores se asignan en UpdateInfo porque dependen del tema efectivo y de la
                             ocupación; el ancho del relleno son las columnas estrella de CapacityColumns. -->
                        <!-- Bloque de ocupación: etiqueta a la izquierda y dato a la derecha en la MISMA
                             línea, con su separador, y la barra debajo.

                             El dato va FUERA de la barra: dentro habría que resolver qué hay debajo del
                             texto cuando la unidad se llena (el relleno pasa por detrás del rótulo), y eso
                             obliga a medir anchos o a darle fondo propio. Fuera es texto de la tarjeta, con
                             el contraste de cualquier otro. Y va emparejado con una etiqueta porque, suelto,
                             era el único texto alineado a la derecha de toda la tarjeta.

                             6 px: la barra es el único bloque de color saturado de la tarjeta, y a 10 px
                             pesaba más que el título de sección. Es un dato, no un control. -->
                        <StackPanel x:Name="CapacityPanel" Spacing="6" Margin="0,2,0,0"
                                    Visibility="Collapsed">
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <TextBlock x:Name="CapacityLbl" Grid.Column="0"
                                           Style="{StaticResource InfoTextStyle}" Text="Ocupación" />
                                <TextBlock x:Name="CapacityText" Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource InfoTextStyle}"
                                           AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                            <Border x:Name="CapacityBar" Height="6" CornerRadius="2"
                                    AutomationProperties.AccessibilityView="Content">
                                <Grid x:Name="CapacityColumns" ColumnDefinitions="0*,100*">
                                    <Border x:Name="CapacityUsedFill" Grid.Column="0" CornerRadius="2" />
                                </Grid>
                            </Border>
                            <!-- El espacio libre baja aquí: es la otra mitad de lo que dice la barra, y
                                 arriba estaba a tres líneas de distancia del dato con el que se compara. -->
                            <TextBlock x:Name="InfoFreeText" Style="{StaticResource DriveMetaStyle}"
                                       Text="Libre: –" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Card: Configuración de formato ── -->
                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="10">
                        <!-- El selector de presets vive aquí, no en Configuración → Presets (`T12-04`):
                             configura EXACTAMENTE esta tarjeta, y estaba a tres menús de ella. El menú
                             sigue existiendo —mismo contenido, construido por el mismo código— porque
                             quitarlo rompería la ruta que la gente ya conoce y las pruebas de UI. -->
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                            <FontIcon Glyph="&#xE713;" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock x:Name="FormatGroupLbl" Grid.Column="1" Text="Configuración de formato" Style="{StaticResource SectionTitleStyle}" />
                            <DropDownButton x:Name="PresetsButton" Grid.Column="2" Content="Presets"
                                            HorizontalAlignment="Right" Padding="10,3" FontSize="12">
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="PresetsFlyout" Placement="BottomEdgeAlignedRight" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>

                        <ComboBox x:Name="FileSystemPicker" HorizontalAlignment="Stretch"
                                  Header="Sistema de archivos"
                                  SelectionChanged="FileSystemPicker_SelectionChanged" />
                        <TextBlock x:Name="FsDescText" Style="{StaticResource HintTextStyle}" Margin="2,0,0,0" />

                        <ComboBox x:Name="AllocUnitPicker" HorizontalAlignment="Stretch"
                                  Header="Tamaño de unidad de asignación" Margin="0,2,0,0"
                                  SelectionChanged="FormatOption_Changed" />
                        <!-- T7-03: era el único campo esotérico sin ayuda, mientras el sistema de
                             archivos —que casi todo el mundo sabe elegir— sí la tenía. Misma pista y
                             mismo estilo que FsDescText, justo debajo de su combo. -->
                        <TextBlock x:Name="AllocHintText" Style="{StaticResource HintTextStyle}" Margin="2,0,0,0" />

                        <TextBox x:Name="VolumeLabelBox" MaxLength="32" HorizontalAlignment="Stretch"
                                 Header="Etiqueta del volumen" Margin="0,2,0,0"
                                 TextChanged="VolumeLabelBox_TextChanged" />
                        <!-- Assertive: es un error que bloquea la acción que el usuario está intentando,
                             no información de fondo. El vínculo con VolumeLabelBox (DescribedBy) se hace en
                             code-behind: en WinUI, AutomationProperties.DescribedBy es una colección y no
                             admite x:Reference desde XAML. -->
                        <TextBlock x:Name="LabelErrorText" FontSize="12" TextWrapping="Wrap"
                                   Margin="2,-4,0,0" Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Assertive"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                        <Button x:Name="RestoreButton" Content="Restaurar valores predeterminados"
                                HorizontalAlignment="Stretch" Margin="0,2,0,0"
                                Click="RestoreButton_Click" />
                    </StackPanel>
                </Border>

                <!-- ── Card: Opciones de formato ── -->
                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock x:Name="OptionsGroupLbl" Text="Opciones de formato" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <CheckBox x:Name="QuickFormatCheck" Content="Formato rápido" IsChecked="True"
                                  Checked="FormatOption_Changed" Unchecked="FormatOption_Changed" />
                        <CheckBox x:Name="CompressCheck"    Content="Habilitar compresión (solo NTFS)" IsEnabled="False"
                                  Checked="FormatOption_Changed" Unchecked="FormatOption_Changed" />
                        <CheckBox x:Name="SecureWipeCheck"  Content="Borrado seguro (sobrescribir espacio libre)"
                                  Checked="SecureWipeCheck_Toggled" Unchecked="SecureWipeCheck_Toggled" />
                        <StackPanel x:Name="WipePassesPanel" Orientation="Horizontal" Spacing="8"
                                    Margin="30,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="WipePassesLbl" Text="Pasadas:" VerticalAlignment="Center"
                                       Style="{StaticResource HintTextStyle}" />
                            <ComboBox x:Name="WipePassesPicker" MinWidth="64" IsEnabled="False"
                                      SelectionChanged="WipePassesPicker_SelectionChanged">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="7" />
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="SmallFat32Check"
                                  Visibility="Collapsed"
                                  Checked="SmallFat32Check_Toggled" Unchecked="SmallFat32Check_Toggled" />
                        <StackPanel x:Name="SmallFat32SizePanel" Orientation="Horizontal" Spacing="8"
                                    Margin="30,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="SmallFat32SizeLbl" Text="Tamaño:" VerticalAlignment="Center"
                                       Style="{StaticResource HintTextStyle}" />
                            <!-- Sin items fijos: se pueblan por código con los tamaños que caben de verdad
                                 en el disco físico seleccionado (ver PopulateSmallFat32Sizes). -->
                            <ComboBox x:Name="SmallFat32SizePicker" MinWidth="80" IsEnabled="False"
                                      SelectionChanged="SmallFat32SizePicker_SelectionChanged" />
                        </StackPanel>
                        <!-- T5-02: el sobrante deja de morir sin asignar. Misma operación y misma
                             confirmación destructiva; lo único que cambia es cuántas particiones se crean. -->
                        <StackPanel x:Name="RestPanel" Orientation="Horizontal" Spacing="8"
                                    Margin="30,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="RestLbl" Text="El resto del disco:" VerticalAlignment="Center"
                                       Style="{StaticResource HintTextStyle}" />
                            <ComboBox x:Name="RestPicker" MinWidth="190" IsEnabled="False"
                                      SelectionChanged="RestPicker_SelectionChanged" />
                        </StackPanel>
                        <StackPanel x:Name="RestDetailPanel" Orientation="Horizontal" Spacing="6"
                                    Margin="30,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="RestFsLbl" Text="Formato:" VerticalAlignment="Center"
                                       Style="{StaticResource HintTextStyle}" />
                            <ComboBox x:Name="RestFsPicker" MinWidth="86"
                                      SelectionChanged="RestFsPicker_SelectionChanged" />
                            <TextBlock x:Name="RestLabelLbl" Text="Etiqueta:" VerticalAlignment="Center"
                                       Style="{StaticResource HintTextStyle}" />
                            <TextBox x:Name="RestLabelBox" MinWidth="104" MaxLength="32" />
                        </StackPanel>
                        <TextBlock x:Name="RestNoteText" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                   Margin="30,2,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="SmallFat32HintText" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                   Margin="30,-2,0,0" Visibility="Collapsed" />
                        <HyperlinkButton x:Name="SmallFat32GoButton" Padding="0" Margin="30,-4,0,0"
                                         Visibility="Collapsed" Click="MnuReinit_Click" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

            <!-- ── «Hay más abajo» (T12-06) ────────────────────────────────────────────────────

                 La ventana es de tamaño fijo, así que el contenido casi siempre desborda, y quedaba una
                 tarjeta cortada por el borde inferior sin nada que lo dijera — con las OPCIONES de
                 formato debajo.

                 Este galón ocupa su PROPIA fila (`Auto`), no flota encima del contenido. No es un
                 detalle de estilo: los dos intentos anteriores fallaron justamente por superponerse.
                 Ver `UpdateScrollAffordance` para el registro de los dos.

                 Raw: es una pista visual. Un lector de pantalla ya recorre el contenido entero,
                 desborde o no, y anunciar un galón decorativo solo estorbaría. -->
            <FontIcon x:Name="ScrollMoreHint" Grid.Row="1" Glyph="&#xE70D;" FontSize="10"
                      Foreground="{ThemeResource AppMutedTextBrush}"
                      Margin="0,1,0,3" Visibility="Collapsed"
                      AutomationProperties.AccessibilityView="Raw" />
        </Grid>

        <!-- Row 3: Footer action bar (progress + status + actions), Win11Debloat-style -->
        <Border Grid.Row="3" Style="{StaticResource FooterBarStyle}">
            <StackPanel Spacing="8">

                <ProgressBar x:Name="FormatProgress" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <!-- Región activa: el estado cambia durante minutos u horas sin que nada mueva el
                         foco. Polite (no Assertive) porque el progreso no debe interrumpir lo que el
                         usuario esté leyendo; los HITOS se anuncian aparte, con AnnounceStatus. -->
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" FontSize="12.5"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="ElapsedText" Grid.Column="1" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Opacity="0.55" FontSize="12" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0" ColumnSpacing="10">
                    <Button x:Name="CloseButton" Content="Cerrar" MinWidth="110"
                            Click="CloseButton_Click" />
                    <!-- Qué se va a aplicar, junto al botón que lo aplica (`T12-03`). La columna del
                         medio estaba vacía y la tarjeta «Opciones de formato» queda bajo el pliegue en
                         una ventana de alto fijo: sin esto se puede pulsar Formatear sin haber visto
                         nunca las opciones con las que se formatea. Se oculta durante la operación —ahí
                         manda StatusText, que además es la región activa del pie— y el detalle completo
                         (compresión incluida) está en su tooltip. -->
                    <TextBlock x:Name="FormatSummaryText" Grid.Column="1"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource DriveMetaStyle}" />
                    <Button x:Name="StartButton" Grid.Column="2" Content="Iniciar" MinWidth="130"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="StartButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</Window>
