<ContentDialog
    x:Class="FormatDiskPro.UI.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CornerRadius="8">

    <ContentDialog.PrimaryButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </ContentDialog.PrimaryButtonStyle>
    <ContentDialog.CloseButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </ContentDialog.CloseButtonStyle>

    <ContentDialog.Resources>
        <!-- Etiqueta de cada fila del detalle (las crea el constructor). Estilo y no un pincel de
             Application.Current.Resources: ver HealthRowLabelStyle en HealthDialog.xaml (`T13-01`). -->
        <Style x:Key="ConfirmRowLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ConfirmRowValueStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="12" Padding="{StaticResource DialogContentPadding}" MinWidth="{StaticResource DialogContentMinWidth}" MaxWidth="{StaticResource DialogContentMaxWidth}">
        <!-- Prosa en la fuente normal y el detalle en un Grid de dos columnas (`T13-04`). Antes era un único
             bloque en Consolas alineado con espacios a mano: cuadraba en español y en ningún otro idioma. -->
        <ScrollViewer MaxHeight="220">
            <StackPanel Spacing="10">
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
                <Grid x:Name="DetailsGrid" ColumnDefinitions="Auto,*" ColumnSpacing="16" RowSpacing="4"
                      Margin="12,0,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="NoteText" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="PromptText" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        <TextBox x:Name="InputBox" MaxLength="1" HorizontalAlignment="Stretch"
                 PlaceholderText="…" />
    </StackPanel>

</ContentDialog>
