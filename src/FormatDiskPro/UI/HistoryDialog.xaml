<ContentDialog
    x:Class="FormatDiskPro.UI.HistoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FormatDiskPro.UI"
    CornerRadius="8">

    <ContentDialog.CloseButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.CloseButtonStyle>

    <Grid MinWidth="{StaticResource DialogContentMinWidth}" MaxWidth="{StaticResource DialogContentMaxWidth}" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">

        <StackPanel Grid.Row="0" Spacing="8">
            <!-- T7-05: AutoSuggestBox por el botón de limpiar que trae de serie (un TextBox obligaba a
                 borrar a mano lo tecleado). No sugiere nada —no hay corpus que sugerir—, así que se le
                 apaga la lista desplegable; el nombre accesible se fija en el constructor, para no
                 depender del placeholder como nombre (la lección de T6-02). -->
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Buscar…" QueryIcon="Find"
                            IsSuggestionListOpen="False" TextChanged="Search_Changed" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <ComboBox x:Name="CategoryFilter" Grid.Column="0" HorizontalAlignment="Stretch"
                          SelectionChanged="Filter_Changed" />
                <ComboBox x:Name="ResultFilter" Grid.Column="1" HorizontalAlignment="Stretch"
                          SelectionChanged="Filter_Changed" />
            </Grid>
            <!-- Cuántas entradas se ven de cuántas hay: con dos filtros y una búsqueda encima, una
                 lista corta no dice por sí sola si el historial está vacío o si lo está ocultando.
                 Polite: cambia con cada tecleo, y no debe interrumpir lo que se está escribiendo. -->
            <TextBlock x:Name="CountText" FontSize="12" Opacity="0.6" HorizontalAlignment="Right"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- ContainerContentChanging (T7-07): sin él, el ListViewItem se anuncia con el ToString() del
             record —«HistoryRow { Time = …, Glyph = , Accent = Microsoft.UI.Xaml.Media.SolidColorBrush }»—
             porque su contenido es un objeto, no texto. Es la fila entera lo que hay que nombrar, y el
             nombre va en el CONTENEDOR: ponerlo en la plantilla no cambia el del ListViewItem. -->
        <ListView x:Name="EntriesList" Grid.Row="1" MaxHeight="320" SelectionMode="None"
                  ContainerContentChanging="EntriesList_ContainerContentChanging">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="ui:HistoryRow">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,4">
                        <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" Foreground="{x:Bind Accent}"
                                  FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{x:Bind Accent}" />
                                <TextBlock Text="{x:Bind Time}" FontSize="12" Opacity="0.6"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Opacity="0.6" Visibility="Collapsed"
                   Text="Sin operaciones registradas." />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button x:Name="OpenFileButton" Content="Abrir archivo" Click="OpenFile_Click" />
            <!-- Ctrl+E dentro del diálogo (T7-04). Aquí el ToolTip lo pone WinUI solo, con el texto del
                 acelerador, porque el botón no tiene ninguno propio que lo desplace. -->
            <Button x:Name="ExportButton" Content="Exportar CSV" Click="Export_Click">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="E" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button x:Name="ClearButton" Content="Vaciar historial">
                <Button.Flyout>
                    <Flyout x:Name="ClearFlyout">
                        <StackPanel Spacing="10" MinWidth="200">
                            <TextBlock x:Name="ClearConfirmText" TextWrapping="Wrap"
                                       Text="¿Vaciar el historial?" />
                            <Button x:Name="ClearConfirmButton" Content="Vaciar"
                                    HorizontalAlignment="Right" Click="ClearConfirm_Click" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <!-- Un ContentDialog no puede abrir otro (WinUI solo permite uno a la vez), así que el fallo de
             la exportación se cuenta AQUÍ dentro. Antes se lo tragaba un catch vacío: el usuario elegía
             destino, no veía nada y se quedaba creyendo que había exportado. -->
        <InfoBar x:Name="ExportErrorBar" Grid.Row="3" Severity="Error" IsOpen="False"
                 IsClosable="True" AutomationProperties.LiveSetting="Assertive" />

    </Grid>
</ContentDialog>
