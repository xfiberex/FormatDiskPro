<ContentDialog
    x:Class="FormatDiskPro.UI.HealthDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CornerRadius="8">

    <ContentDialog.CloseButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.CloseButtonStyle>
    <ContentDialog.SecondaryButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.SecondaryButtonStyle>

    <ContentDialog.Resources>
        <!-- Etiqueta de cada fila (las crea AddRow desde código). Estilo y no un pincel sacado de
             Application.Current.Resources: el tema se fuerza en el diálogo (RequestedTheme), y ese
             diccionario devuelve el del tema de Windows. El ThemeResource de un Setter se resuelve con
             el tema del propio elemento. -->
        <Style x:Key="HealthRowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="10" Padding="{StaticResource DialogContentPadding}" MinWidth="{StaticResource DialogContentMinWidth}" MaxWidth="{StaticResource DialogContentMaxWidth}">
        <TextBlock x:Name="StatusText" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel x:Name="RowsPanel" Spacing="6" />
        <TextBlock x:Name="NoteText" FontSize="12" Foreground="{ThemeResource AppMutedTextBrush}" TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
